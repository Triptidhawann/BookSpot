# Copy to backend/.env for local development; set these in the backend deployment environment in production.
PORT=2007

# Aiven MySQL connection URL. URL-encode special characters in credentials.
DB_URL=mysql://user:password@host:3306/bookspot

# Use a randomly generated secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h

# Set unique administrator credentials. Production requires a password of at least 16 characters.
ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters-long

# Public frontend URL used in generated QR codes.
FRONTEND_URL=http://localhost:5173

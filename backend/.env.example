# ========================================================
# BookSpot Library Allocation System - Backend Environment
# Location: BookSpot/BookSpot/backend/.env
# ========================================================

# 1. Server Port
PORT=2007

# 2. MySQL Database Connection URL
# Format: mysql://<username>:<password>@<host>:<port>/<database>
# Replace YOUR_MYSQL_PASSWORD with the password you set for MySQL (e.g., in MySQL Workbench)
DB_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/bookspot"

# 3. Fixed Admin Credentials & Security
# Admin Username / ID
ADMIN_USERNAME="admin"

# Pre-computed Bcrypt Hash for password "Admin@12345" (Salt rounds: 10)
# (If you ever want to change the password later, generate a new bcrypt hash and paste it here)
ADMIN_PASSWORD_HASH="$2b$10$.tUPFwQSL6trvPstSSHwY.1be8grlMZjCyLMdEOYdZ8sfRPw7/CaC"

# JWT Secret Key for signing admin authentication tokens
ADMIN_JWT_SECRET="bookspot_admin_jwt_secret_key_2026_super_secure"

# Token expiration time
ADMIN_JWT_EXPIRES_IN="8h"
